# Origin HTTPS que sirve la Biblia (manifest.json, bible.json, rvr60.json).
# En desarrollo local se puede dejar vacío: la app usa /content y el proxy de Vite.
VITE_CANTICO_CONTENT_BASE_URL=https://contenido.tudominio.com/cantico

# Origin HTTPS de Firebase Hosting que sirve los himnarios instalables
# (hymns-meta.json, hymns.json, alabanzas.html, armonia.html).
# Si se deja vacío, se usa VITE_CANTICO_CONTENT_BASE_URL como fallback.
VITE_CANTICO_HYMNS_BASE_URL=https://TU_PROYECTO.web.app
