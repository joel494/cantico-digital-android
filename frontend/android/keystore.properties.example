# Copiar a keystore.properties (ignorado por git) y rellenar con datos reales.
# Generar el keystore una sola vez con:
# keytool -genkeypair -v -keystore cantico-digital.jks -keyalg RSA -keysize 2048 -validity 10000 -alias cantico
KEYSTORE_PATH=./android/cantico-digital.jks
KEYSTORE_PASSWORD=cambia-este-valor
KEYSTORE_ALIAS=cantico
KEYSTORE_ALIAS_PASSWORD=cambia-este-valor
